---
import BaseLayout from '../components/BaseLayout.astro';

const products = [
  ['Pilihan Pioneer 01', 'Produk pilihan untuk aktivitas, kreativitas, dan keseharian Pioneer.', 'https://s.shopee.co.id/8Kp96LAPuh', '01'],
  ['Pilihan Pioneer 02', 'Temukan detail, pilihan variasi, dan harga terbaru di Shopee.', 'https://s.shopee.co.id/2qUCYGN3OS', '02'],
  ['Pilihan Pioneer 03', 'Pilihan partner yang kami tampilkan untuk komunitas Pioneer.', 'https://s.shopee.co.id/AAGnHmA8kc', '03'],
  ['Pilihan Pioneer 04', 'Lihat informasi lengkap dan lakukan pembelian langsung melalui Shopee.', 'https://s.shopee.co.id/1BLyZGCeuV', '04'],
  ['Pilihan Pioneer 05', 'Satu lagi pilihan praktis yang dapat dijelajahi melalui Shopee.', 'https://s.shopee.co.id/20v5YoMlMI', '05'],
];
---

<BaseLayout title="Pioneer Pilihan — Pioneer Indonesia" description="Etalase pilihan partner untuk komunitas Pioneer Indonesia. Pembelian dilakukan melalui Shopee.">
  <section class="hero-shell relative overflow-hidden border-b border-gold-500/10"><span class="orb orb-one"></span><span class="orb orb-two"></span><div class="relative mx-auto max-w-7xl px-6 pb-12 pt-28 sm:px-10 lg:px-14"><p class="section-kicker">Pioneer Pilihan</p><h1 class="section-title max-w-3xl">Etalase kecil untuk <span class="gold-gradient-text">Pioneer yang bergerak.</span></h1><p class="mt-6 max-w-2xl text-base leading-8 text-white/60 sm:text-lg">Temukan pilihan partner yang bermanfaat untuk aktivitas, karya, dan keseharian. Detail serta pembelian tetap dilakukan di Shopee.</p></div></section>

  <section class="mx-auto max-w-7xl px-6 pb-20 pt-10 sm:px-10 lg:px-14">
    <div class="mb-7 flex items-end justify-between gap-4"><div><p class="section-kicker">Partner pilihan</p><h2 class="mt-2 text-2xl font-bold text-white">Jelajahi rekomendasi.</h2></div><span class="rounded-full border border-gold-500/25 bg-gold-500/10 px-3 py-1.5 text-xs font-semibold text-gold-300">5 pilihan</span></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map(([title, description, href, number]) => <article class="group overflow-hidden rounded-3xl border border-white/10 bg-[linear-gradient(145deg,rgba(78,38,151,.24),rgba(12,5,29,.72))] p-5 transition hover:-translate-y-1 hover:border-gold-500/35"><div class="flex aspect-[16/10] items-end justify-between rounded-2xl border border-gold-500/20 bg-[radial-gradient(circle_at_25%_20%,rgba(238,189,73,.28),transparent_28%),linear-gradient(135deg,#3c1975,#13072b_72%)] p-5"><span class="text-5xl font-serif font-bold text-gold-300/90">{number}</span><span class="rounded-full border border-white/15 bg-black/20 px-3 py-1 text-[.65rem] font-bold uppercase tracking-[.16em] text-white/70">Partner</span></div><h2 class="mt-5 text-xl font-bold text-white">{title}</h2><p class="mt-2 min-h-12 text-sm leading-6 text-white/55">{description}</p><a class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#EE4D2D] px-4 py-3 text-sm font-bold text-white transition hover:bg-[#ff5c3b]" href={href} target="_blank" rel="sponsored noreferrer">Lihat di Shopee <span aria-hidden="true">↗</span></a></article>)}
    </div>
    <p class="mt-8 text-xs leading-6 text-white/40">Harga dan ketersediaan mengikuti halaman Shopee masing-masing.</p>
  </section>
</BaseLayout>
