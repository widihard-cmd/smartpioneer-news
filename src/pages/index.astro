---
import BaseLayout from '../components/BaseLayout.astro';
import Guestbook from '../components/Guestbook';

const features = [
  ['Pi Music', 'Dengarkan karya Pioneer, buat playlist, dan lihat lagu yang sedang naik.', '/music', '♫'],
  ['Levy Vision', 'Gagasan tentang komunitas, teknologi, kemandirian, dan masa depan.', '/levy-vision', '✦'],
  ['Pi Market', 'Ringkasan pasar yang jernih dengan sumber dan waktu pembaruan.', '/market', '↗'],
  ['Pi News', 'Kabar pilihan ekosistem Pi tanpa sensasi dan klaim yang kabur.', '/news', '◫'],
];
---

<BaseLayout ogImage="/images/levy-hero-v1.png">
  <section class="hero-shell relative flex min-h-[88vh] items-center overflow-hidden px-5 pb-24 pt-28">
    <img
      src="/images/levy-hero-v1.png"
      alt="Levy, wajah Pioneer Indonesia, di studio musik modern"
      class="absolute inset-y-0 right-0 hidden h-full w-[64%] object-cover object-center lg:block"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 hidden bg-[linear-gradient(90deg,#0D0520_0%,#0D0520_35%,rgba(13,5,32,.82)_48%,rgba(13,5,32,.12)_78%)] lg:block"></div>
    <div class="absolute inset-0 bg-[linear-gradient(0deg,#0D0520_0%,transparent_35%)]"></div>
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>

    <div class="relative mx-auto w-full max-w-screen-xl">
      <div class="max-w-2xl">
        <span class="pi-badge mb-6">The voice of Indonesian Pioneers</span>
        <h1 class="text-5xl font-bold leading-[.98] tracking-[-.04em] text-white md:text-7xl">
          Suara Pioneer.<br />
          <span class="gold-gradient-text">Masa depan Indonesia.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-pi-100/70">
          Satu ruang digital untuk musik, informasi pasar, kabar ekosistem, dan Levy Vision—dibangun agar komunitas datang kembali setiap hari.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="btn-primary" href="/music">Putar Pi Music <span>▶</span></a>
          <a class="glass-card px-6 py-3 text-sm font-semibold" href="/levy-vision">Jelajahi Levy Vision</a>
        </div>

        <figure class="mt-10 overflow-hidden rounded-2xl border border-gold-500/20 lg:hidden">
          <img
            src="/images/levy-hero-v1.png"
            alt="Levy di studio musik Pioneer Indonesia"
            class="aspect-[4/3] w-full object-cover object-[68%_center]"
            loading="eager"
          />
        </figure>

        <div class="mt-12 flex flex-wrap gap-8 text-sm text-pi-200/50">
          <span><b class="block text-xl text-white">24/7</b>Pioneer Radio</span>
          <span><b class="block text-xl text-white">5</b>Ruang utama</span>
          <span><b class="block text-xl text-white">ID</b>Untuk Indonesia</span>
        </div>
      </div>

    </div>
  </section>

  <Guestbook client:load />

  <section class="mx-auto max-w-screen-xl px-5 pb-16 pt-3">
    <div class="flex items-end justify-between gap-4"><div><p class="section-kicker">Jelajahi portal</p><h2 class="mt-2 text-2xl font-bold text-white">Ruang utama Pioneer Indonesia.</h2></div><span class="text-gold-300">✦</span></div>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{features.map(([title, description, href, icon]) => <a href={href} class="group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[.035] p-4 transition hover:-translate-y-1 hover:border-gold-500/35"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gold-400/10 text-lg text-gold-300">{icon}</span><span><b class="block text-sm text-white">{title}</b><small class="mt-1 block text-xs leading-5 text-white/48">{description.split(',')[0]}</small></span></a>)}</div>
  </section>
</BaseLayout>
