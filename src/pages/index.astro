---
import BaseLayout from '../components/BaseLayout.astro';
const features = [['Pi Music','Dengarkan karya Pioneer, buat playlist, dan lihat lagu yang sedang naik.','/music','♫'],['Levy Vision','Gagasan tentang komunitas, teknologi, kemandirian, dan masa depan.','/levy-vision','✦'],['Pi Market','Ringkasan pasar yang jernih dengan sumber dan waktu pembaruan.','/market','↗'],['Pi News','Kabar pilihan ekosistem Pi tanpa sensasi dan klaim yang kabur.','/news','◫']];
---
<BaseLayout><section class="hero-shell relative flex min-h-[88vh] items-center overflow-hidden px-5 pb-24 pt-28"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="relative mx-auto grid w-full max-w-screen-xl gap-14 lg:grid-cols-[1.15fr_.85fr] lg:items-center"><div><span class="pi-badge mb-6">The voice of Indonesian Pioneers</span><h1 class="max-w-4xl text-5xl font-bold leading-[.98] tracking-[-.04em] text-white md:text-7xl">Suara Pioneer.<br/><span class="gold-gradient-text">Masa depan Indonesia.</span></h1><p class="mt-7 max-w-2xl text-lg leading-8 text-pi-200/65">Satu ruang digital untuk musik, informasi pasar, kabar ekosistem, dan Levy Vision—dibangun agar komunitas datang kembali setiap hari.</p><div class="mt-9 flex flex-wrap gap-3"><a class="btn-primary" href="/music">Putar Pi Music <span>▶</span></a><a class="glass-card px-6 py-3 text-sm font-semibold" href="/levy-vision">Jelajahi Levy Vision</a></div><div class="mt-12 flex flex-wrap gap-8 text-sm text-pi-200/50"><span><b class="block text-xl text-white">24/7</b>Pioneer Radio</span><span><b class="block text-xl text-white">5</b>Ruang utama</span><span><b class="block text-xl text-white">ID</b>Untuk Indonesia</span></div></div><div class="glass-card relative mx-auto w-full max-w-md overflow-hidden p-8"><div class="absolute right-5 top-4 text-8xl font-bold text-gold-500/10">π</div><p class="text-xs uppercase tracking-[.3em] text-gold-300">Levy presents</p><div class="my-10 grid aspect-square place-items-center rounded-full border border-gold-500/20 bg-gradient-to-br from-pi-700/50 to-pi-950 shadow-2xl"><div class="text-center"><div class="text-7xl">✦</div><p class="mt-3 text-2xl font-bold">LEVY</p><p class="text-xs tracking-[.35em] text-gold-300">VISION</p></div></div><p class="leading-7 text-pi-100/70">“Teknologi harus memperkuat manusia, karya, dan komunitas—bukan menjauhkan mereka.”</p></div></div></section><section class="mx-auto max-w-screen-xl px-5 py-20"><p class="section-kicker">Explore the ecosystem</p><h2 class="section-title">Semua yang dibutuhkan Pioneer, dalam satu portal.</h2><div class="mt-10 grid gap-5 md:grid-cols-2">{features.map(([title,desc,href,icon]) => <a href={href} class="glass-card group p-7"><div class="mb-8 text-3xl text-gold-300">{icon}</div><h3 class="text-2xl font-semibold text-white">{title}</h3><p class="mt-3 leading-7 text-pi-200/60">{desc}</p><span class="mt-6 inline-block text-sm text-gold-300 transition group-hover:translate-x-1">Buka ruang →</span></a>)}</div></section></BaseLayout>
