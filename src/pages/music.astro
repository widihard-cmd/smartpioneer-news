---
import BaseLayout from '../components/BaseLayout.astro';
import MusicLibrary from '../components/MusicLibrary';
---
<BaseLayout title="Pi Music — Pioneer Indonesia" description="Dengarkan 12 lagu SmartPioneer dengan player, equalizer, playlist pribadi, dan play analytics.">
  <section class="mx-auto min-h-[80vh] max-w-screen-xl px-5 pb-24 pt-32">
    <p class="section-kicker">πWAVE • Pioneer Radio</p>
    <h1 class="section-title max-w-4xl">Musik yang menggerakkan komunitas.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-pi-200/60">Pilih lagu, simpan favorit ke playlist pribadi, lalu tetap dengarkan saat menjelajahi portal. Metadata seluruh koleksi sudah diseragamkan sebagai SmartPioneer Music.</p>
    <MusicLibrary client:load />
  </section>
</BaseLayout>
