---
import BaseLayout from '../components/BaseLayout.astro';

const steps = [
  { number: '01', title: 'Kedaulatan Digital Indonesia', body: 'Indonesia bergerak dari pengguna menjadi pencipta teknologi, data, dan ekosistem digital sendiri.', phase: 'Fondasi' },
  { number: '02', title: 'Satu Desa, Satu AI Nusantara', body: 'Asisten AI lokal membantu pertanian, UMKM, pendidikan, kesehatan, dan layanan publik di setiap desa.', phase: 'Pemerataan' },
  { number: '03', title: 'AI Musyawarah Nasional', body: 'Teknologi merangkum aspirasi publik secara real-time tanpa menggantikan keputusan manusia.', phase: 'Partisipasi' },
  { number: '04', title: 'DPR 2.0 — Dewan Rakyat Digital', body: 'Kebijakan lebih transparan, dapat ditelusuri, dan terbuka terhadap pengawasan serta suara masyarakat.', phase: 'Demokrasi' },
  { number: '05', title: 'Blockchain Pemerintahan Transparan', body: 'Anggaran dan proyek publik memiliki jejak data yang akuntabel serta sulit dimanipulasi.', phase: 'Integritas' },
  { number: '06', title: 'Zero Paper Government', body: 'Layanan publik menjadi cepat, sederhana, terhubung, dan bebas dari birokrasi berulang.', phase: 'Layanan' },
  { number: '07', title: 'Dana Kreativitas Nusantara', body: 'Dana efisiensi diarahkan kepada karya rakyat, riset, startup, UMKM, dan infrastruktur masa depan.', phase: 'Kreativitas' },
  { number: '08', title: 'Pi Digital Economy Movement', body: 'Ekonomi komunitas yang aman, adil, inklusif, dan mendorong transaksi bernilai nyata.', phase: 'Ekonomi' },
  { number: '09', title: 'Satu Juta AI Engineer Indonesia', body: 'Pelatihan berjenjang, akses belajar luas, serta kompetisi inovasi untuk generasi pembangun.', phase: 'Talenta' },
  { number: '10', title: 'Garuda AI Initiative', body: 'AI nasional yang memahami bahasa, budaya, nilai, dan kebutuhan seluruh wilayah Nusantara.', phase: 'Kemandirian' },
  { number: '11', title: 'AI + Blockchain untuk UMKM', body: 'Akses analisis usaha, pasar, dan pembiayaan yang membantu UMKM tumbuh lebih kuat.', phase: 'Produktivitas' },
  { number: '12', title: 'Indonesia 2045: AI Superpower', body: 'Visi jangka panjang menuju kekuatan teknologi yang manusiawi, berdaulat, dan diperhitungkan dunia.', phase: 'Masa depan' },
];

const principles = [
  ['Didengar', 'Setiap suara rakyat berharga.'],
  ['Dibantu AI', 'Teknologi bekerja untuk manusia.'],
  ['Diutamakan', 'Kesejahteraan menjadi ukuran kemajuan.'],
  ['Dipimpin dengan hati', 'Inovasi berjalan bersama nurani.'],
];
---

<BaseLayout
  title="Levy Vision 2029 — Pioneer Indonesia"
  description="Dua belas langkah besar Levy Vision 2029 untuk Indonesia maju bersama AI, blockchain, dan ekonomi digital komunitas."
  ogImage="/images/levy-vision-2029.webp"
>
  <section class="vision-hero relative overflow-hidden border-b border-gold-500/10 px-5 pb-20 pt-32">
    <div class="orb orb-one"></div>
    <div class="mx-auto grid max-w-screen-xl items-center gap-12 lg:grid-cols-[1.02fr_.98fr]">
      <div class="relative z-10">
        <p class="section-kicker">Levy Vision • Indonesia 2029</p>
        <h1 class="section-title max-w-3xl">Teknologi maju.<br/><span class="gold-gradient-text">Manusia diutamakan.</span></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-pi-200/65">Levy Vision adalah peta gagasan untuk menjadikan AI, blockchain, dan ekonomi digital sebagai alat pemerataan—bukan sekadar simbol kemajuan.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href="#dua-belas-langkah">Jelajahi 12 langkah</a>
          <a class="rounded-xl border border-white/10 px-6 py-3 text-sm font-semibold text-white/80 transition hover:border-gold-500/40" href="#prinsip">Prinsip Levy</a>
        </div>
        <div class="mt-10 grid max-w-xl grid-cols-3 gap-3">
          <div class="vision-stat"><strong>12</strong><span>langkah besar</span></div>
          <div class="vision-stat"><strong>2029</strong><span>target gerakan</span></div>
          <div class="vision-stat"><strong>2045</strong><span>arah Indonesia</span></div>
        </div>
      </div>

      <figure class="poster-wrap relative z-10 mx-auto w-full max-w-[590px]">
        <img src="/images/levy-vision-2029.webp" width="1024" height="1536" alt="Poster Levy Vision 2029 dengan 12 langkah besar Indonesia bersama AI dan Pi Network" loading="eager" decoding="async" />
        <figcaption>Dokumen visual utama • Levy Vision 2029</figcaption>
      </figure>
    </div>
  </section>

  <section id="dua-belas-langkah" class="mx-auto max-w-screen-xl px-5 py-24">
    <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <p class="section-kicker">Roadmap gagasan</p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight text-white md:text-5xl">12 langkah untuk Indonesia maju.</h2>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-pi-200/60">Setiap langkah saling menguatkan: talenta membangun teknologi, teknologi memperbaiki layanan, transparansi menjaga kepercayaan, dan ekonomi digital membuka kesempatan.</p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {steps.map((step) => (
        <article class="vision-card group">
          <div class="flex items-start justify-between gap-5">
            <span class="step-number">{step.number}</span>
            <span class="pi-badge">{step.phase}</span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <div class="card-line"></div>
        </article>
      ))}
    </div>
  </section>

  <section id="prinsip" class="border-y border-gold-500/10 bg-pi-900/25 px-5 py-24">
    <div class="mx-auto grid max-w-screen-xl gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="section-kicker">Kompas perubahan</p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight text-white md:text-5xl">Empat prinsip yang tidak boleh ditawar.</h2>
        <blockquote class="mt-8 border-l-2 border-gold-500 pl-6 text-xl leading-9 text-pi-100/80">“Negara bukan dibangun oleh banyak meja kantor. Negara dibangun oleh banyak tangan yang berkarya.”</blockquote>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {principles.map(([title, body], index) => (
          <article class="glass-card p-6">
            <span class="text-2xl text-gold-300">{['◉', '✦', '♥', '★'][index]}</span>
            <h3 class="mt-5 text-lg font-semibold text-white">{title}</h3>
            <p class="mt-2 leading-7 text-pi-200/55">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-5 py-24">
    <div class="vision-cta mx-auto max-w-screen-xl overflow-hidden rounded-3xl border border-gold-500/20 p-8 md:p-14">
      <p class="section-kicker">Dari suara rakyat, untuk masa depan bangsa</p>
      <div class="mt-4 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <h2 class="max-w-3xl text-3xl font-bold tracking-tight text-white md:text-5xl">Mari wujudkan Indonesia yang cerdas, maju, dan sejahtera.</h2>
        <a class="btn-primary shrink-0" href="/music">Dengarkan suara Pioneer</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .vision-hero { background: linear-gradient(135deg, rgba(44, 15, 92, .72), rgba(13, 5, 32, .96) 58%); }
  .poster-wrap { padding: 1px; border-radius: 24px; background: linear-gradient(145deg, rgba(245,197,24,.8), rgba(139,114,224,.18)); box-shadow: 0 28px 80px rgba(0,0,0,.48); }
  .poster-wrap img { display:block; width:100%; border-radius:23px; }
  .poster-wrap figcaption { padding:.8rem 1rem 1rem; text-align:center; color:rgba(232,228,255,.48); font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; }
  .vision-stat { display:flex; min-height:88px; flex-direction:column; justify-content:center; border:1px solid rgba(245,197,24,.14); border-radius:14px; background:rgba(255,255,255,.035); padding:14px; }
  .vision-stat strong { color:#f5c518; font-size:1.35rem; }
  .vision-stat span { margin-top:3px; color:rgba(232,228,255,.46); font-size:.7rem; }
  .vision-card { position:relative; min-height:270px; overflow:hidden; border:1px solid rgba(245,197,24,.14); border-radius:18px; background:linear-gradient(150deg,rgba(82,53,184,.14),rgba(255,255,255,.025)); padding:1.5rem; transition:transform .25s ease,border-color .25s ease; }
  .vision-card:hover { transform:translateY(-4px); border-color:rgba(245,197,24,.42); }
  .step-number { font-size:2.4rem; font-weight:700; line-height:1; color:rgba(245,197,24,.9); letter-spacing:-.05em; }
  .vision-card h3 { margin-top:2rem; color:#fff; font-size:1.18rem; font-weight:650; }
  .vision-card p { margin-top:.8rem; color:rgba(232,228,255,.56); line-height:1.75; }
  .card-line { position:absolute; right:1.5rem; bottom:1.2rem; left:1.5rem; height:1px; background:linear-gradient(90deg,rgba(245,197,24,.5),transparent); transform-origin:left; transform:scaleX(.25); transition:transform .3s ease; }
  .vision-card:hover .card-line { transform:scaleX(1); }
  .vision-cta { background:radial-gradient(circle at 80% 20%,rgba(245,197,24,.12),transparent 32%),linear-gradient(135deg,rgba(82,53,184,.32),rgba(13,5,32,.9)); }
  @media (max-width:640px){ .vision-stat { min-height:78px; padding:10px; } .vision-stat strong{font-size:1.05rem}.vision-stat span{font-size:.62rem}.poster-wrap{border-radius:18px}.poster-wrap img{border-radius:17px} }
</style>
