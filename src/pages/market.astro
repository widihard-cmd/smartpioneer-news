---
import BaseLayout from '../components/BaseLayout.astro';
import PiMarketDashboard from '../components/PiMarketDashboard';
---
<BaseLayout title="Pi Market — Pioneer Indonesia" description="Harga Pi dalam rupiah, chart candlestick, dan statistik pasar dari CoinGecko.">
  <section class="hero-shell relative isolate overflow-hidden border-b border-gold-500/10"><img src="/images/flow-market-hero-v1.png" alt="Flow menganalisis pergerakan Pi Market" class="absolute inset-y-0 right-0 -z-10 hidden h-full w-[68%] object-cover object-center lg:block" loading="eager" fetchpriority="high" /><div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#0d0520_0%,#0d0520_35%,rgba(13,5,32,.90)_49%,rgba(13,5,32,.20)_78%,rgba(13,5,32,.68)_100%)]"></div><span class="orb orb-one"></span><span class="orb orb-two"></span><div class="relative mx-auto max-w-7xl px-6 pb-8 pt-20 sm:px-10 lg:px-14"><p class="section-kicker">Pi Market · Indonesia</p><h1 class="section-title max-w-3xl">Pasar bergerak cepat. <span class="gold-gradient-text">Data harus tetap jernih.</span></h1><p class="mt-6 max-w-2xl text-base leading-8 text-white/65 sm:text-lg">Pantau harga Pi dalam rupiah, perubahan 24 jam, dan pola pasar tujuh hari terakhir dalam satu tampilan yang mudah dibaca.</p><figure class="mt-8 overflow-hidden rounded-2xl border border-gold-500/20 lg:hidden"><img src="/images/flow-market-hero-v1.png" alt="Flow menganalisis pergerakan Pi Market" class="aspect-[16/9] w-full object-cover object-[70%_center]" loading="eager" /></figure></div></section>
  <PiMarketDashboard client:load />
</BaseLayout>
