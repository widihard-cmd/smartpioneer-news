---
import BaseLayout from '../components/BaseLayout.astro';
import PiMarketDashboard from '../components/PiMarketDashboard';
---
<BaseLayout title="Pi Market — Pioneer Indonesia" description="Harga Pi dalam rupiah, chart candlestick, dan statistik pasar dari CoinGecko.">
  <section class="hero-shell relative isolate min-h-[440px] overflow-hidden border-b border-gold-500/10">
    <img src="/images/flow-market-hero-v1.png" alt="Flow menganalisis pergerakan Pi Market" class="absolute inset-y-0 right-0 z-0 hidden h-full w-[72%] object-contain object-right lg:block" loading="eager" fetchpriority="high" />
    <img src="/images/flow-market-hero-v1.png" alt="" aria-hidden="true" class="absolute inset-0 z-0 h-full w-full object-cover object-right opacity-90 lg:hidden" loading="eager" />
    <div class="absolute inset-0 z-[1] hidden bg-[linear-gradient(90deg,#0d0520_0%,#0d0520_35%,rgba(13,5,32,.90)_49%,rgba(13,5,32,.20)_78%,rgba(13,5,32,.68)_100%)] lg:block"></div>
    <div class="absolute inset-0 z-[1] bg-[linear-gradient(180deg,rgba(13,5,32,.15)_0%,rgba(13,5,32,.46)_55%,#0d0520_100%)] lg:hidden"></div>
    <span class="orb orb-one"></span><span class="orb orb-two"></span>
    <div class="relative z-10 mx-auto max-w-7xl px-6 pb-12 pt-28 sm:px-10 lg:px-14"><p class="section-kicker">Pi Market · Indonesia</p><h1 class="section-title max-w-3xl">Pasar bergerak cepat. <span class="gold-gradient-text">Data harus tetap jernih.</span></h1><p class="mt-6 max-w-2xl text-base leading-8 text-white/70 sm:text-lg">Pantau harga Pi dalam rupiah, perubahan 24 jam, dan pola pasar tujuh hari terakhir dalam satu tampilan yang mudah dibaca.</p></div>
  </section>
  <PiMarketDashboard client:load />
</BaseLayout>
