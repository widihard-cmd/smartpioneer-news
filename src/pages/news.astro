---
import BaseLayout from '../components/BaseLayout.astro';
import { officialPiNews } from '../data/officialPiNews';

const featured = officialPiNews.find((item) => item.featured)!;
const updates = officialPiNews.filter((item) => !item.featured);
const dateFormat = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Pi News — Official Updates Indonesia" description="Ringkasan Bahasa Indonesia dari pembaruan resmi Pi Network, dengan tautan langsung ke sumber aslinya.">
  <section class="hero-shell relative overflow-hidden border-b border-gold-500/10">
    <span class="orb orb-one"></span><span class="orb orb-two"></span>
    <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-20 sm:px-10 lg:px-14">
      <div class="max-w-3xl">
        <p class="section-kicker">Pi News · Official Updates Indonesia</p>
        <h1 class="section-title">Kabar resmi Pi Network, <span class="gold-gradient-text">lebih dekat untuk Indonesia.</span></h1>
        <p class="mt-6 text-base leading-8 text-white/60 sm:text-lg">Ringkasan berbahasa Indonesia dari blog resmi Pi Network. Tanpa rumor, tanpa klaim tambahan—selalu dengan tautan ke pengumuman asli.</p>
      </div>
      <div class="mt-9 flex flex-wrap gap-2 text-xs font-semibold"><span class="rounded-full border border-gold-500/30 bg-gold-400/10 px-3 py-1.5 text-gold-300">Sumber resmi · minepi.com</span><span class="rounded-full border border-white/10 px-3 py-1.5 text-white/55">Kurasi Bahasa Indonesia</span><span class="rounded-full border border-white/10 px-3 py-1.5 text-white/55">6 pembaruan pilihan</span></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-14 sm:px-10 lg:px-14">
    <article class="overflow-hidden rounded-[2rem] border border-gold-500/25 bg-[linear-gradient(135deg,rgba(93,47,178,.42),rgba(14,6,33,.9)_62%)] p-7 shadow-2xl shadow-black/25 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_.85fr] lg:items-end">
        <div>
          <p class="section-kicker">Pembaruan terbaru · {dateFormat.format(new Date(`${featured.publishedAt}T00:00:00`))}</p>
          <h2 class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-white sm:text-5xl">{featured.title}</h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-white/65">{featured.summary}</p>
          <a href={featured.sourceUrl} target="_blank" rel="noreferrer" class="btn-primary mt-8">Baca pengumuman asli <span aria-hidden="true">↗</span></a>
        </div>
        <div class="rounded-3xl border border-gold-500/20 bg-[#13072a]/60 p-6"><p class="text-xs font-bold uppercase tracking-[.2em] text-gold-300">Mengapa penting?</p><p class="mt-4 text-lg font-semibold leading-7 text-white">Perkembangan alat developer membuka lebih banyak ruang bagi Pioneer untuk membangun dan mencoba aplikasi yang berguna.</p><p class="mt-4 text-sm leading-6 text-white/50">Perspektif Pioneer Indonesia · ringkasan konteks, bukan pernyataan dari Pi Core Team.</p></div>
      </div>
    </article>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-12 pt-14 sm:px-10 lg:px-14">
    <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="section-kicker">Arsip pembaruan</p><h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl">Yang perlu diketahui Pioneer.</h2></div><a href="https://minepi.com/blog/" target="_blank" rel="noreferrer" class="text-sm font-semibold text-gold-300 transition hover:text-gold-200">Lihat blog resmi Pi Network ↗</a></div>
    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {updates.map((item, index) => <article class="group flex min-h-[250px] flex-col rounded-3xl border border-white/10 bg-white/[.035] p-6 transition duration-300 hover:-translate-y-1 hover:border-gold-500/35 hover:bg-white/[.055]" style={`animation-delay:${index * 70}ms`}>
        <div class="flex items-center justify-between gap-3"><span class="pi-badge">{item.category}</span><time class="text-xs text-white/45" datetime={item.publishedAt}>{dateFormat.format(new Date(`${item.publishedAt}T00:00:00`))}</time></div>
        <h3 class="mt-6 text-xl font-bold leading-snug text-white transition group-hover:text-gold-300">{item.title}</h3>
        <p class="mt-3 text-sm leading-6 text-white/58">{item.summary}</p>
        <a href={item.sourceUrl} target="_blank" rel="noreferrer" class="mt-auto pt-6 text-sm font-semibold text-gold-300">Sumber resmi <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-4 sm:px-10 lg:px-14"><div class="rounded-3xl border border-white/10 bg-white/[.025] p-7 text-sm leading-7 text-white/55"><p class="font-semibold text-white">Tentang Pi News</p><p class="mt-2">Pioneer Indonesia adalah portal komunitas independen dan tidak berafiliasi resmi dengan Pi Network. Judul dan ringkasan di halaman ini dibuat dalam Bahasa Indonesia untuk membantu pembaca memahami pembaruan; rujukan utama tetap pengumuman asli di <a class="text-gold-300 underline decoration-gold-500/40 underline-offset-4" href="https://minepi.com/blog/" target="_blank" rel="noreferrer">minepi.com/blog</a>.</p></div></section>
</BaseLayout>
