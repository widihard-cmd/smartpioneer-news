---
const path = Astro.url.pathname;
const links = [['/', 'Home'], ['/music', 'Pi Music'], ['/levy-vision', 'Levy Vision'], ['/market', 'Pi Market'], ['/news', 'Pi News']];
---
<header class="glass-nav fixed inset-x-0 top-0 z-40"><div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-5">
  <a href="/" class="flex items-center gap-3 font-bold tracking-wide text-white"><span class="grid h-9 w-9 place-items-center rounded-xl border border-gold-500/40 bg-pi-800 text-gold-300">π</span><span>PIONEER <span class="gold-gradient-text">INDONESIA</span></span></a>
  <button id="nav-toggle" class="rounded-lg border border-white/10 px-3 py-2 text-sm md:hidden" aria-label="Buka menu">Menu</button>
  <nav class="hidden items-center gap-1 md:flex">{links.map(([href,label]) => <a href={href} class:list={['rounded-lg px-3 py-2 text-sm transition', path === href ? 'bg-gold-500/10 text-gold-300' : 'text-pi-200/70 hover:text-white']}>{label}</a>)}</nav>
</div><nav id="nav-mobile" class="hidden border-t border-white/10 bg-pi-950/95 px-5 py-3 md:hidden">{links.map(([href,label]) => <a href={href} class="block rounded-lg px-3 py-2 text-pi-100">{label}</a>)}</nav></header>
<script>document.querySelector('#nav-toggle')?.addEventListener('click',()=>document.querySelector('#nav-mobile')?.classList.toggle('hidden'));</script>
