---
import BrandLogo from './BrandLogo.astro';
import PiAuthButton from './PiAuthButton';

const path = Astro.url.pathname;
const links = [['/', 'Home'], ['/music', 'Pi Music'], ['/levy-vision', 'Levy Vision'], ['/market', 'Pi Market'], ['/news', 'Pi News']];
---
<header class="glass-nav fixed inset-x-0 top-0 z-40"><div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-5">
  <a href="/" class="rounded-xl transition hover:opacity-90"><BrandLogo /></a>
  <details class="group relative md:hidden"><summary class="list-none rounded-lg border border-white/10 px-3 py-2 text-sm text-white marker:hidden">Menu <span class="ml-1 text-gold-300 group-open:hidden">☰</span><span class="ml-1 hidden text-gold-300 group-open:inline">×</span></summary><nav class="absolute right-0 top-[3.25rem] w-56 rounded-xl border border-white/10 bg-[#110625]/95 p-2 shadow-2xl backdrop-blur"><a href="/" class="block rounded-lg px-3 py-3 text-sm text-pi-100 hover:bg-white/5">Home</a><a href="/music" class="block rounded-lg px-3 py-3 text-sm text-pi-100 hover:bg-white/5">Pi Music</a><a href="/levy-vision" class="block rounded-lg px-3 py-3 text-sm text-pi-100 hover:bg-white/5">Levy Vision</a><a href="/market" class="block rounded-lg px-3 py-3 text-sm text-pi-100 hover:bg-white/5">Pi Market</a><a href="/news" class="block rounded-lg px-3 py-3 text-sm text-pi-100 hover:bg-white/5">Pi News</a></nav></details>
  <nav class="hidden items-center gap-1 md:flex">{links.map(([href,label]) => <a href={href} class:list={['rounded-lg px-3 py-2 text-sm transition', path === href ? 'bg-gold-500/10 text-gold-300' : 'text-pi-200/70 hover:text-white']}>{label}</a>)}</nav>
  <PiAuthButton client:load />
</div></header>
