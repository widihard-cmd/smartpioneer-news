---
import BaseLayout from './BaseLayout.astro';
interface Props { kicker:string; title:string; intro:string; cards:{title:string;body:string;meta?:string}[] }
const {kicker,title,intro,cards}=Astro.props;
---
<BaseLayout title={`${title} — Pioneer Indonesia`}><section class="mx-auto min-h-[80vh] max-w-screen-xl px-5 pb-24 pt-32"><p class="section-kicker">{kicker}</p><h1 class="section-title max-w-4xl">{title}</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-pi-200/60">{intro}</p><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{cards.map(card=><article class="glass-card p-7"><p class="mb-8 text-xs uppercase tracking-[.2em] text-gold-300">{card.meta||'Pioneer Indonesia'}</p><h2 class="text-xl font-semibold text-white">{card.title}</h2><p class="mt-3 leading-7 text-pi-200/60">{card.body}</p></article>)}</div></section></BaseLayout>
